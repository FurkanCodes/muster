{
  "name": "muster-desktop",
  "private": true,
  "version": "0.6.1",
  "description": "Muster's desktop app: the webview half. The Rust half is src-tauri.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "pnpm typecheck && vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 1421 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e-app.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:app": "MUSTER_E2E_BUILD=1 tauri build --debug --no-bundle --features e2e --ci && wdio run wdio.conf.ts",
    "bindings": "./scripts/bindings.sh",
    "replies": "cd src-tauri && MUSTER_WRITE_REPLIES=1 cargo test --locked --test replies",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
